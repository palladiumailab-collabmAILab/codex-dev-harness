{
  "schema_version": 1,
  "policy": {
    "default_route": "gpt-5.6-sol / medium",
    "bounded_worker_route": "gpt-5.6-luna / max",
    "escalation_target": "gpt-5.6-sol / medium",
    "implementation_route": "gpt-5.6-luna / max",
    "test_execution_route": "gpt-5.6-luna / max",
    "protected_test_owner_route": "gpt-5.6-sol / medium",
    "protected_test_change_mode": "pr_only",
    "profile": "profiles/sol-luna/AGENTS.md",
    "task_prompt": "templates/task-prompts/sol-luna.md",
    "max_profile_chars": 1800,
    "max_task_prompt_chars": 1600,
    "test_asset_owner_route": "gpt-5.6-sol / medium",
    "luna_test_change_permission": "proposal_pr_only"
  },
  "tasks": [
    {
      "id": "small-implementation",
      "kind": "bounded implementation",
      "expected_route": "luna",
      "required_profile": "sol-luna",
      "reason": "A bounded implementation with fixed acceptance criteria is delegated to Luna.",
      "additional_profiles": []
    },
    {
      "id": "test-execution",
      "kind": "test execution",
      "expected_route": "luna",
      "required_profile": "sol-luna",
      "reason": "Running tests and collecting deterministic evidence is a Luna worker task.",
      "additional_profiles": []
    },
    {
      "id": "protected-test-change",
      "kind": "oracle change",
      "expected_route": "sol",
      "required_profile": "sol-luna",
      "reason": "Changing an existing oracle requires independent evidence and Sol review; a Luna proposal stays PR-only.",
      "additional_profiles": []
    },
    {
      "id": "bounded-search",
      "kind": "bounded exploration",
      "expected_route": "luna",
      "required_profile": "sol-luna",
      "reason": "A bounded, independently checkable search can use the Luna worker route.",
      "additional_profiles": []
    },
    {
      "id": "cross-cutting-debug",
      "kind": "cross-cutting debugging",
      "expected_route": "sol",
      "required_profile": "sol-luna",
      "reason": "Cross-cutting judgment and repeated failure analysis return to Sol.",
      "additional_profiles": []
    },
    {
      "id": "new-unit-test-change",
      "kind": "test code change",
      "expected_route": "sol",
      "required_profile": "sol-luna",
      "reason": "Generating or modifying test code is owned by Sol; Luna may only propose the change in a review PR.",
      "additional_profiles": []
    }
  ]
}
