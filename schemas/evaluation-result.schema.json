{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/palladiumailab-collabmAILab/codex-dev-harness/schemas/evaluation-result.schema.json",
  "title": "Harness evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "criteria", "raw_metrics", "acceptance", "evaluator", "provenance"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "decision": { "enum": ["accept", "reject", "unresolved"] },
    "criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "raw_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" }
    },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "evaluator": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "required", "status", "evidence", "note"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": { "enum": ["met", "unmet", "unresolved"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": ["string", "null"] }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseline", "candidate", "direction", "improvement", "min_improvement", "allowed_regression", "required", "critical"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseline": { "type": "number" },
        "candidate": { "type": "number" },
        "direction": { "enum": ["higher", "lower"] },
        "improvement": { "type": "number" },
        "min_improvement": { "type": "number", "minimum": 0 },
        "allowed_regression": { "type": "number", "minimum": 0 },
        "required": { "type": "boolean" },
        "critical": { "type": "boolean" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "tied", "min_confidence", "reasons"],
      "properties": {
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "tied": { "type": "boolean" },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
